{
  "name": "@opencx/widget",
  "private": false,
  "version": "5.0.0-beta.4",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/openchatai/widget"
  },
  "scripts": {
    "clean": "rm -rf node_modules dist-embed .turbo",
    "clean:dist": "rm -rf dist-embed .turbo",
    "build": "NODE_ENV=production vite build -c vite.config.ts && NODE_ENV=production vite build -c vite.loader.config.ts && node ../../scripts/check-production-build.mjs dist-embed",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepack": "node ../../scripts/check-production-build.mjs dist-embed"
  },
  "files": [
    "dist-embed",
    "!dist-embed/**/*.map"
  ],
  "devDependencies": {
    "@opencx/eslint-config": "workspace:*",
    "@opencx/tsconfig": "workspace:*",
    "@opencx/widget-core": "workspace:*",
    "@opencx/widget-react": "workspace:*",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
