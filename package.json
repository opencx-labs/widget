{
  "name": "@opencx/widget-monorepo-root",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "/* ------------------------ SETUP ----------------------- */": "",
    "gen:sdk": "pnpm -F @opencx/widget-core gen:sdk",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "clean:dist": "turbo clean:dist && rm -rf .turbo",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "pnpm test:build && turbo test",
    "/* --------------------- DEVELOPMENT -------------------- */": "",
    "dev:prepare": "dotenv -- turbo dev:prepare --env-mode",
    "dev": "dotenv -- turbo dev --env-mode",
    "/* --------------------- PUBLISHING --------------------- */": "",
    "x": "pnpm clean:dist && pnpm build && pnpm lint && pnpm type-check && pnpm test",
    "cs:pre": "changeset pre enter beta",
    "cs:pre:exit": "changeset pre exit",
    "cs": "changeset",
    "csv": "changeset version",
    "csp": "pnpm x && changeset publish",
    "release:beta": "pnpm x && pnpm publish -r --tag beta --no-git-checks",
    "test:build": "node --test scripts/check-production-build.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@opencx/eslint-config": "workspace:*",
    "@types/node": "^20.14.8",
    "@vitejs/plugin-react-swc": "^4.0.0",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.23.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.5",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-dts": "4.0.3",
    "vite-plugin-externalize-deps": "^0.9.0",
    "vite-tsconfig-paths": "^5.0.1",
    "vitest": "^3.0.2"
  },
  "pnpm": {
    "overrides": {
      "mdast-util-gfm-autolink-literal": "2.0.0",
      "form-data@4": ">=4.0.6 <5",
      "ws@8": ">=8.21.0 <9",
      "brace-expansion@1": ">=1.1.16 <2",
      "brace-expansion@2": ">=2.1.2 <3",
      "js-yaml@3": ">=3.15.2 <4",
      "js-yaml@4": ">=4.3.2 <5",
      "postcss@8": ">=8.5.23 <9",
      "postcss-selector-parser@6": ">=6.1.3 <7",
      "nanoid@3": ">=3.3.18 <4",
      "@humanfs/node": ">=0.16.8 <0.17"
    }
  }
}
